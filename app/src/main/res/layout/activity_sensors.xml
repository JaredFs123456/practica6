<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootSensors"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SensorsActivity">


<TextView
        android:id="@+id/txtTituloSensores"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sensores del dispositivo"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Grupo sensor de proximidad -->
    <TextView
        android:id="@+id/txtProximidadTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Sensor de proximidad"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/txtTituloSensores"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/swProximidad"
        android:layout_marginTop="32dp"
        android:layout_marginStart="16dp" />

    <Switch
        android:id="@+id/swProximidad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Activar"
        app:layout_constraintTop_toTopOf="@id/txtProximidadTitulo"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp" />

    <TextView
        android:id="@+id/txtProximidadValor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Valor: --"
        app:layout_constraintTop_toBottomOf="@id/txtProximidadTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp" />

    <!-- Grupo sensor de luz -->
    <TextView
        android:id="@+id/txtLuzTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Sensor de luz"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/txtProximidadValor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/swLuz"
        android:layout_marginTop="32dp"
        android:layout_marginStart="16dp" />

    <Switch
        android:id="@+id/swLuz"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Activar"
        app:layout_constraintTop_toTopOf="@id/txtLuzTitulo"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp" />

    <TextView
        android:id="@+id/txtLuzValor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Valor: --"
        app:layout_constraintTop_toBottomOf="@id/txtLuzTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
